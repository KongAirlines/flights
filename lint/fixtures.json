  ]
},
{
  "tool": "kongctl",
  "rules": "lint/openapi.yaml",
  "document": {
    "info": {
      "version": "0.5.0-beta.1"
    },
    "paths": {
      "/flights": {}
    }
  },
  "cases": [
    {"name": "stable development version", "rule": "current-contract", "changes": [{"path": ["info", "version"], "value": "0.5.0"}]},
    {"name": "missing version", "rule": "current-contract", "changes": [{"path": ["info", "version"], "delete": true}]},
    {"name": "internal /health", "rule": "current-contract", "changes": [{"path": ["paths", "/health"], "value": {}}]},
    {"name": "internal /internal/ready", "rule": "current-contract", "changes": [{"path": ["paths", "/internal/ready"], "value": {}}]},
    {"name": "internal /live/", "rule": "current-contract", "changes": [{"path": ["paths", "/live/"], "value": {}}]}
  ]
}
]
